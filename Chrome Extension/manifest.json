{
  "manifest_version": 3,
  "name": "LLMBDA - Prompt Optimizer",
  "version": "1.0",
  "description": "Optimize your prompts for tokens using AI.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:8000/*", 
    "https://api.groq.com/*", 
    "https://api.openai.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png"
  }
}